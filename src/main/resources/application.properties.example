spring.application.name=testlogin

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/restaurant_order_system?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=your_password_here
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# WeChat Mini Program Configuration
wx.mini.appid=your_appid_here
wx.mini.secret=your_secret_here

# JWT Configuration
jwt.secret=your_jwt_secret_here
jwt.expiration=604800000
